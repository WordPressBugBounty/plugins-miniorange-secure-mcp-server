{"translation-revision-date":"YEAR-MO-DA HO:MI+ZONE","generator":"WP-CLI\/2.12.0","source":"views\/public\/plans\/standard\/js\/deactivation-feedback.js","domain":"messages","locale_data":{"messages":{"":{"domain":"messages","lang":"ar","plural-forms":"nplurals=6; plural=(n == 0) ? 0 : ((n == 1) ? 1 : ((n == 2) ? 2 : ((n % 100 >= 3 && n % 100 <= 10) ? 3 : ((n % 100 >= 11 && n % 100 <= 99) ? 4 : 5))));"},"Which tool or plugin are you switching to?":["\u0645\u0627 \u0627\u0644\u0623\u062f\u0627\u0629 \u0623\u0648 \u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0627\u0644\u062a\u064a \u0633\u062a\u0646\u062a\u0642\u0644 \u0625\u0644\u064a\u0647\u0627\u061f"],"e.g. another MCP plugin":["\u0645\u062b\u0644\u064b\u0627: \u0625\u0636\u0627\u0641\u0629 MCP \u0623\u062e\u0631\u0649"],"What features were missing?":["\u0645\u0627 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u064a \u0643\u0627\u0646\u062a \u0646\u0627\u0642\u0635\u0629\u061f"],"Tell us what you needed":["\u0623\u062e\u0628\u0631\u0646\u0627 \u0628\u0645\u0627 \u0643\u0646\u062a \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u064a\u0647"],"Sorry that happened \u2014 most issues are quick to sort out.":["\u0646\u0623\u0633\u0641 \u0644\u062d\u062f\u0648\u062b \u0630\u0644\u0643 \u2014 \u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0634\u0643\u0644\u0627\u062a \u062a\u064f\u062d\u0644 \u0628\u0633\u0631\u0639\u0629."],"Open troubleshooting before you go":["\u0627\u0641\u062a\u062d \u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0648\u0625\u0635\u0644\u0627\u062d\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629"],"Keep it & get help":["\u0627\u0644\u0625\u0628\u0642\u0627\u0621 \u0639\u0644\u064a\u0647\u0627 \u0648\u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629"],"Setup guide":["\u062f\u0644\u064a\u0644 \u0627\u0644\u0625\u0639\u062f\u0627\u062f"],"We read every request and triage them weekly \u2014 what you note here goes on the list.":["\u0646\u0642\u0631\u0623 \u0643\u0644 \u0637\u0644\u0628 \u0648\u0646\u0641\u0631\u0632 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627 \u2014 \u0645\u0627 \u062a\u0643\u062a\u0628\u0647 \u0647\u0646\u0627 \u064a\u064f\u0636\u0627\u0641 \u0625\u0644\u0649 \u0627\u0644\u0642\u0627\u0626\u0645\u0629."],"Keep it & talk to us":["\u0627\u0644\u0625\u0628\u0642\u0627\u0621 \u0639\u0644\u064a\u0647\u0627 \u0648\u0627\u0644\u062a\u062d\u062f\u062b \u0625\u0644\u064a\u0646\u0627"],"We\u2019d genuinely like to know which \u2014 it\u2019s how we get better.":["\u0646\u0648\u062f\u0651 \u062d\u0642\u064b\u0627 \u0623\u0646 \u0646\u0639\u0631\u0641 \u0623\u064a\u0651\u0647\u0627 \u2014 \u0641\u0647\u0643\u0630\u0627 \u0646\u062a\u062d\u0633\u0651\u0646."],"No problem \u2014 your settings and connections stay saved for when you\u2019re back.":["\u0644\u0627 \u0645\u0634\u0643\u0644\u0629 \u2014 \u062a\u0628\u0642\u0649 \u0625\u0639\u062f\u0627\u062f\u0627\u062a\u0643 \u0648\u0627\u062a\u0635\u0627\u0644\u0627\u062a\u0643 \u0645\u062d\u0641\u0648\u0638\u0629 \u0644\u062d\u064a\u0646 \u0639\u0648\u062f\u062a\u0643."],"We\u2019re listening \u2014 tell us more below.":["\u0646\u062d\u0646 \u0646\u0633\u062a\u0645\u0639 \u2014 \u0623\u062e\u0628\u0631\u0646\u0627 \u0628\u0627\u0644\u0645\u0632\u064a\u062f \u0623\u062f\u0646\u0627\u0647."],"Before you go, %s\u2026":["\u0642\u0628\u0644 \u0623\u0646 \u062a\u063a\u0627\u062f\u0631 \u064a\u0627 %s\u2026"],"%s day":["%s \u064a\u0648\u0645","\u064a\u0648\u0645 \u0648\u0627\u062d\u062f","\u064a\u0648\u0645\u0627\u0646","%s \u0623\u064a\u0627\u0645","%s \u064a\u0648\u0645\u064b\u0627","%s \u064a\u0648\u0645"],"%s week":["%s \u0623\u0633\u0628\u0648\u0639","\u0623\u0633\u0628\u0648\u0639 \u0648\u0627\u062d\u062f","\u0623\u0633\u0628\u0648\u0639\u0627\u0646","%s \u0623\u0633\u0627\u0628\u064a\u0639","%s \u0623\u0633\u0628\u0648\u0639\u064b\u0627","%s \u0623\u0633\u0628\u0648\u06